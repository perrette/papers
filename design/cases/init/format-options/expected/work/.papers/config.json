{
  "bibtex": "papers.bib",
  "editor": "vim",
  "filesdir": "files",
  "keyformat": {
    "author_num": 3,
    "template": "{author}_{year}"
  },
  "nameformat": {
    "template": "{author}_{title}",
    "title_sep": "_",
    "unknown_strict": false
  },
  "paths": "relative",
  "pool": "none",
  "version": 3
}