# $WORK/.papers/config.json
bibtex                = $WORK/papers.bib  (library)
filesdir              = $WORK/files  (library)
pool                  = none  (library)
paths                 = relative  (library)
files                 = move  (default)
auto-push             = false  (default)
editor                = vim  (library)
checksums             = true  (default)
history-dir           =   (default)
history-size          = 500  (default)
history-separate      = false  (default)
keep-deleted-files    = true  (default)
name.template         = {author}_{title}  (library)
name.author-num       = 2  (default)
name.author-sep       = _  (default)
name.title-word-num   = 100  (default)
name.title-word-size  = 1  (default)
name.title-length     = 100  (default)
name.title-sep        = _  (library)
name.unknown-template = unknown_{doi_or_id}  (default)
name.unknown-strict   = false  (library)
key.template          = {author}_{year}  (library)
key.author-num        = 3  (library)
key.author-sep        = _  (default)
key.title-word-num    = 100  (default)
key.title-word-size   = 1  (default)
key.title-length      = 100  (default)
key.title-sep         = -  (default)
key.unknown-template  = {doi_}  (default)
key.unknown-strict    = false  (default)
