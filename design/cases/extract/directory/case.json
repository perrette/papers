        "extract",
        "--doi-only",
        "-R",
        "pdfs/sub"
      ],
      "contract": [
        "stdout"
      ]
    },
    {
      "argv": [
        "extract",
        "--doi-only",
        "-R",
        "empty"
      ],
      "contract": [
        "stdout"
      ]
    },
    {
      "argv": [
        "extract",
        "--doi-only",
        "-R",
