    {
      "argv": [
        "tag"
      ]
    },
    {
      "argv": [
        "tag",
        "--rename",
        "ocean/amoc",
        "ocean/moc"
      ]
    },
    {
      "argv": [
        "tag"
      ]
    },
    {
      "argv": [
        "list",
        "-K",
