# $WORK/lib/.papers/config.json
bibtex                = $WORK/lib/sub/refs.bib  (library)
filesdir              = $WORK/lib/files2  (library, not used: shallow library)
pool                  = ../pool  (library)
paths                 = relative  (default)
files                 = move  (default)
auto-push             = false  (default)
editor                =   (default)
checksums             = true  (default)
history-dir           =   (default)
history-size          = 500  (default)
history-separate      = false  (default)
keep-deleted-files    = true  (default)
name.template         = {authorX}_{year}_{title}  (default, not used: shallow library)
name.author-num       = 2  (default, not used: shallow library)
name.author-sep       = _  (default, not used: shallow library)
name.title-word-num   = 100  (default, not used: shallow library)
name.title-word-size  = 1  (default, not used: shallow library)
name.title-length     = 100  (default, not used: shallow library)
name.title-sep        = -  (default, not used: shallow library)
name.unknown-template = unknown_{doi_or_id}  (default, not used: shallow library)
name.unknown-strict   = false  (default, not used: shallow library)
key.template          = {author}{year}  (default)
key.author-num        = 2  (default)
key.author-sep        = _  (default)
key.title-word-num    = 100  (default)
key.title-word-size   = 1  (default)
key.title-length      = 100  (default)
key.title-sep         = -  (default)
key.unknown-template  = {doi_}  (default)
key.unknown-strict    = false  (default)
