{
  "description": "add without a file makes an entry of the fields given (--key, --title, --author, --year, --journal, --type, --metadata), with a key from the template unless --key (without author and year: from the title); an attachment is placed as the files setting says; nothing given, or only --type, is an error; the same paper twice is a duplicate",
  "sections": [
    "bibtex.md#3.3",
    "bibtex.md#8",
    "formats.md#1.2",
    "formats.md#7.3"
  ],
  "tests": [
    "tests/test_entry_cmds.py::TestAddEmptyKey::test_add"
  ],
  "steps": [
    {
      "argv": [
        "add",
        "--key",
        "new2022",
        "--title",
        "A new paper",
        "--author",
        "Jane Roe",
        "--year",
        "2022",
        "--journal",
        "J. Things",
        "--metadata",
        "note=hello",
        "volume=3"
      ]
    },
    {
      "argv": [
        "add",
        "--title",
        "Second paper",
        "--author",
        "Doe, John and Roe, Jane",
        "--year",
        "2023",
        "--type",
        "book"
      ]
    },
    {
      "argv": [
        "add",
        "--type",
        "book"
      ]
    },
    {
      "argv": [
        "add"
      ]
    },
    {
      "argv": [
        "add",
        "--title",
        "With attachment",
        "--author",
        "Ann Bee",
        "--year",
        "2021",
        "--attach",
        "dl/c.txt",
        "--copy"
      ]
    },
    {
      "argv": [
        "add",
        "--title",
        "Second paper",
        "--author",
        "Doe, John and Roe, Jane",
        "--year",
        "2023",
        "-u",
        "--on-duplicate",
        "skip"
      ]
    },
    {
      "argv": [
        "add",
        "--title",
        "Second paper",
        "--author",
        "Doe, John and Roe, Jane",
        "--year",
        "2023",
        "-u"
      ]
    },
    {
      "argv": [
        "add",
        "--title",
        "No author or year"
      ]
    },
    {
      "argv": [
        "list",
