        "--rename"
      ]
    },
    {
      "argv": [
        "config",
        "name.template",
        "{nosuch}"
      ]
    },
    {
      "argv": [
        "list",
        "a2020",
        "--rename"
      ]
    },
    {
      "argv": [
        "config",
        "name.template",
        "{year.real}"
      ]
    },
    {
      "argv": [
        "list",
        "--tag",
        "x",
        "--rename",
        "--keep-source"
